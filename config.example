# zoom-quiet config (~/.config/zoom-quiet/config)
# zoom-quiet の設定ファイル
# Apply changes / 反映: launchctl kickstart -k gui/$(id -u)/com.github.zoom-quiet

# Seconds between checks / 何秒ごとに会議中かを見るか
INTERVAL=5

# "Not in a meeting" checks in a row before turning the Focus off
# 会議の外と何回続けて判定したら集中モードを切るか
LEAVE_CHECKS=2

# Message language: auto (follows macOS) | ja | en
# メッセージの言語: auto（macOSの設定に合わせる）| ja | en
UI_LANG=auto

# Shortcut names. Defaults: "Zoom Quiet On" / "Zoom Quiet Off" (English), "Zoom中オン" / "Zoom中オフ" (Japanese)
# ショートカットの名前。既定は英語環境で "Zoom Quiet On" / "Zoom Quiet Off"、日本語環境で "Zoom中オン" / "Zoom中オフ"
# ON_SHORTCUT="Zoom Quiet On"
# OFF_SHORTCUT="Zoom Quiet Off"

# Run commands instead of Shortcuts (used only when both are set)
# ショートカットの代わりに任意のコマンドを使う場合（両方書いたときだけ有効）
# ON_CMD='say "meeting started"'
# OFF_CMD='say "meeting ended"'

# Abort an on/off action after this many seconds / オン・オフの操作を打ち切る秒数
ACTION_TIMEOUT=20

# In a meeting when zoom.us has at least this many UDP sockets (0 disables)
# Zoom本体の UDP 通信がこの本数以上なら会議中とみなす（0 で無効）
UDP_MIN=1
